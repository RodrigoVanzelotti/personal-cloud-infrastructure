{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "description",
    "repositories",
    "components",
    "secrets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "repositories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "slug"
        ],
        "properties": {
          "provider": {
            "const": "github"
          },
          "slug": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "repository"
        ],
        "properties": {
          "type": {
            "enum": [
              "cloud_run_service",
              "firebase_hosting"
            ]
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,255}$"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
